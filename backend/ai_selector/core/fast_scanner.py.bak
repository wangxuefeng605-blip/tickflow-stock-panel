from core.stock_pool import get_stock_pool
from core.ranking import rank_stocks
from core.scanner.engine import ScannerEngine
from core.intelligence.context_builder import ContextBuilder
from core.intelligence.market_provider import MarketDataProvider
from core.learning.weight_provider import LearningWeightProvider
from core.full_ranking_writer import save_full_ranking


def run_fast_scan(weights=None):

    # =========================
    # 1. Stock Pool
    # =========================

    stocks = get_stock_pool()

    print(
        f"Stock Pool Size: {len(stocks)}"
    )

    # 沒有股票時，不應該繼續啟動
    # MarketDataProvider / ScannerEngine
    if not stocks:
        print(
            "Stock pool is empty; skipping scanner."
        )
        return []


    # =========================
    # 2. AI Intelligence Layer
    # =========================

    market_data = (
        MarketDataProvider()
        .get_market_data()
    )

    ai_context = (
        ContextBuilder()
        .build(
            market_data
        )
    )

    if weights:
        print(
            "Using Learned Weights:",
            weights
        )

        ai_context.weights = weights

    print(
        "AI Weights:",
        ai_context.weights
    )


    # =========================
    # 3. Scanner Engine
    # =========================

    engine = ScannerEngine(
        stocks,
        workers=8,
        context=ai_context
    )

    results, failed_items = engine.scan_batch(
        stocks
    )

    print(
        f"Scan Success: {len(results)}"
    )

    print(
        f"Scan Failed: {len(failed_items)}"
    )

    print(
        "RESULT TYPE:",
        type(results)
    )

    print(
        "RESULT LENGTH:",
        len(results)
    )

    print(
        "RESULT FIRST 10:",
        results[:10]
    )


    # =========================
    # 4. Ranking
    # =========================

    if not results:
        print(
            "No scan results; skipping ranking."
        )
        return []


    weight_provider = LearningWeightProvider()

    ranked = rank_stocks(
        results,
        top_n=len(results),
        weight_provider=weight_provider
    )


    # =========================
    # 5. Full Ranking Report
    # =========================

    save_full_ranking(
        ranked
    )


    # =========================
    # 6. Top 10
    # =========================

    top10 = ranked[:10]

    return top10


if __name__ == "__main__":

    run_fast_scan()